# Dockerfile.httpd
FROM znuny-base AS base
FROM base

LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"

# Install Apache, mod_perl and tooling needed for install/upgrade
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      apache2 libapache2-mod-perl2 rsync && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy app files to staging directory for upgrades
RUN cp -a ${ZNUNY_HOME} /opt/znuny-staging && \
    chown -R znuny:www-data /opt/znuny-staging

# Apache configuration
RUN a2dismod mpm_event && \
    a2enmod mpm_prefork perl headers deflate filter cgi rewrite && \
    echo "RedirectMatch ^/$ /znuny/index.pl" >> /etc/apache2/apache2.conf

ENV APACHE_RUN_USER=www-data \
    APACHE_RUN_GROUP=www-data \
    APACHE_RUN_DIR=/var/run/apache2 \
    APACHE_LOCK_DIR=/var/lock/apache2 \
    APACHE_LOG_DIR=/var/log/apache2 \
    APACHE_PID_FILE=/var/run/apache2/apache2.pid

RUN mkdir -p /var/run/apache2 /var/lock/apache2 /var/log/apache2 && \
    chown -R www-data:www-data /var/run/apache2 /var/lock/apache2 /var/log/apache2 && \
    ln -sf /proc/self/fd/1 /var/log/apache2/access.log && \
    ln -sf /proc/self/fd/2 /var/log/apache2/error.log && \
    ln -sf /proc/self/fd/2 /var/log/apache2/other_vhosts_access.log

EXPOSE 80

# Setup Entry
COPY ./entrypoints/apache.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
COPY ./docker-specific/apache_starter.sh /usr/local/bin/apache_starter.sh
RUN chmod +x /usr/local/bin/apache_starter.sh
RUN chown www-data: /usr/local/bin/apache_starter.sh

# Install and Upgrade scripts (httpd owns the application lifecycle)
COPY ./docker-specific/install.sh /usr/local/bin/install.sh
COPY ./docker-specific/upgrade.sh /usr/local/bin/upgrade.sh
RUN chmod +x /usr/local/bin/install.sh /usr/local/bin/upgrade.sh

USER root
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/local/bin/apache_starter.sh"]
